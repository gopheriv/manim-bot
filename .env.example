# ── Telegram (required) ─────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── LLM: Qwen 3.7 Max (code generation, required) ──────────────────────────
# Get from Alibaba Cloud Model Studio (DashScope)
GPT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GPT_API_KEY=sk-...
MANIM_MODEL=qwen3.7-max

# ── LLM: Qwen 3.6 Plus (chat + vision, required) ───────────────────────────
OPENAI_API_KEY=sk-...
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.6-plus

# ── LLM: Claude Opus 4.8 (optional chat provider) ──────────────────────────
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Switch between qwen and claude for chat
LLM_PROVIDER=qwen

# ── Judge of AI Court (MiniMax M3 — reviews code before render) ─────────────
# Uses a DIFFERENT model from the generator to catch model-blindness bugs
JUDGE_BASE_URL=https://api.iamhc.cn
JUDGE_API_KEY=sk-...
JUDGE_MODEL=MiniMax-M3
JUDGE_TIMEOUT=60
JUDGE_MAX_ITERATIONS=2

# ── Render settings ────────────────────────────────────────────────────────
MANIM_QUALITY=-qm
MANIM_TIMEOUT=600
MANIM_MAX_RETRIES=1
TTS_ENABLED=true

# ── Azure TTS (optional — voiceover narration) ─────────────────────────────
# Get from https://azure.microsoft.com/en-us/products/ai-services/text-to-speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Cloudflare D1 (optional — distributed caching, leave blank for local) ─
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CF_DATABASE_ID=

# ── Image generation (optional) ────────────────────────────────────────────
IMAGE_MODEL=
