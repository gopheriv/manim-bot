# ── Telegram (required) ─────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Owner/admin chat id(s) allowed to use privileged commands like /restart
# (comma-separated). Send the bot a message and check the logs, or use @userinfobot
# to find your numeric id. Empty = privileged commands disabled. WATCHDOG_NOTIFY_CHAT
# (if set) is also treated as an owner.
ADMIN_CHAT_IDS=

# ── LLM: Qwen 3.7 Max (code generation, required) ──────────────────────────
# Get from Alibaba Cloud Model Studio (DashScope)
GPT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GPT_API_KEY=sk-...
MANIM_MODEL=qwen3.7-max

# ── LLM: Qwen 3.6 Plus (chat + vision, required) ───────────────────────────
OPENAI_API_KEY=sk-...
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.6-plus

# ── LLM: Claude Opus 4.8 (optional chat provider) ──────────────────────────
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Switch between qwen and claude for chat
LLM_PROVIDER=qwen

# ── Judge of AI Court (strong, separate model — CORRECTNESS review only) ─────
# Reviews generated code for correctness defects (API misuse, undefined names,
# math/concept errors) before render. Does NOT grade layout/fonts/color/perf —
# those are handled by static checks, the render tier, and the visual critic.
# JUDGE_PROVIDER: "auto" prefers Claude (strongest) when CLAUDE_API_KEY is set,
# else falls back to the JUDGE_* endpoint below. Force with "claude" or "openai".
JUDGE_PROVIDER=auto
JUDGE_BASE_URL=https://api.iamhc.cn
JUDGE_API_KEY=sk-...
JUDGE_MODEL=MiniMax-M3
JUDGE_TIMEOUT=60
JUDGE_MAX_ITERATIONS=2

# ── Render settings ────────────────────────────────────────────────────────
MANIM_QUALITY=-qm          # fallback only; the render tier's default usually wins
MANIM_TIMEOUT=600
MANIM_MAX_RETRIES=1
TTS_ENABLED=true

# ── Render tier (quality scales with hardware) ─────────────────────────────
# auto = detect from RAM/CPU. Force with: cinematic | standard | constrained
#   cinematic  (>=16 GB): 1080p60, Surfaces/3D, richer motion
#   standard   (>=10 GB): 1080p, Surfaces allowed, capped
#   constrained (<10 GB): 720p, strict budget (the 8 GB-laptop behavior)
RENDER_TIER=auto
MANIM_FPS=0                # 0 = use the tier's fps; >0 forces a value

# ── Code generation quality ────────────────────────────────────────────────
MANIM_ENABLE_THINKING=true   # Qwen reasoning ON for code-gen (safeguarded fallback)
MANIM_MAX_OUTPUT_TOKENS=16384 # larger ceiling so ambitious scenes aren't truncated
REVIEW_REPAIR_ENABLED=true    # education/critic findings trigger a real repair
CRITIC_REPAIR_THRESHOLD=6.0   # critic score below this triggers a pre-render fix

# ── Visual feedback loop (render → vision critique → regenerate) ───────────
VISUAL_CRITIC_ENABLED=true
VISUAL_CRITIC_MAX_PASSES=1    # how many critique→regenerate rounds (unlimited time OK)
VISUAL_CRITIC_KEYFRAMES=4     # frames sampled from the render for the vision critic
VISION_PROVIDER=qwen          # which provider scores frames: qwen | claude

# ── Azure TTS (optional — voiceover narration) ─────────────────────────────
# Get from https://azure.microsoft.com/en-us/products/ai-services/text-to-speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Cloudflare D1 (optional — distributed caching, leave blank for local) ─
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CF_DATABASE_ID=

# ── Image generation (optional) ────────────────────────────────────────────
IMAGE_MODEL=

# ── Cloud render farm (optional — GitHub Actions worker) ──────────────────
# Dispatches HD renders (1080p/60fps) to a GitHub Actions workflow instead of
# rendering locally. The bot stays private; only a minimal public *worker* repo
# holds the workflow. Disabled until you create a worker repo and push
# .github/workflows/render.yml + deploy/ci_render.py to it.
#
# Setup:
#   gh repo create gopheriv/manim-render-worker --public
#   # Copy .github/workflows/render.yml + deploy/ci_render.py into it and push
#   # Then enable here:
#
CLOUD_RENDER_ENABLED=false
CLOUD_RENDER_REPO=                    # e.g. gopheriv/manim-render-worker
CLOUD_RENDER_WORKFLOW=render.yml
CLOUD_RENDER_BRANCH=main
CLOUD_RENDER_TIMEOUT=1200             # seconds to await a cloud job (20 min)
CLOUD_RENDER_POLL=10                  # seconds between status polls
